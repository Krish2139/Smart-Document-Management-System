# Environment Configuration
APP_NAME="Smart Document Processing and Management System"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Server Configuration
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500"

# Database Configuration (SQLite for local dev)
DATABASE_URL="sqlite:///./smart_document_manager.db"

# Storage Configuration (local or s3)
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./local_storage/documents"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
